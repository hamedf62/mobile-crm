//@version=6
strategy("GBP/USD Range Strategy", overlay=true, initial_capital=100, default_qty_type=strategy.percent_of_equity)

// ============================================================================
// INPUTS & SETTINGS
// ============================================================================

// Trading parameters
first_trade_size = input.float(40.0, "First Trade Size ($)", minval=1.0, maxval=100.0)
position_increase = input.float(20.0, "Position Size Increase (%)", minval=0.0, maxval=100.0)
max_trades_per_day = input.int(1, "Max Trades Per Day", minval=1)

// Session times (GMT)
london_start = input.session("0800-1000", "London Session (GMT)", tooltip="London session: 8:00-10:00 GMT")
newyork_start = input.session("1300-1500", "New York Session (GMT)", tooltip="New York session: 13:00-15:00 GMT")

// Range detection settings
range_candles = input.int(4, "Range Detection Candles", minval=1, maxval=10)

// Visual settings
show_range = input.bool(true, "Show Range Lines")
show_fibonacci = input.bool(true, "Show Fibonacci Levels")

// ============================================================================
// SESSION DETECTION
// ============================================================================

// Check if we're in London or New York session
in_london_session = not na(time(timeframe.period, london_start))
in_newyork_session = not na(time(timeframe.period, newyork_start))
in_trading_session = in_london_session or in_newyork_session

// Session start detection
london_session_start = in_london_session and not in_london_session[1]
newyork_session_start = in_newyork_session and not in_newyork_session[1]
session_start = london_session_start or newyork_session_start

// ============================================================================
// RANGE DETECTION
// ============================================================================

var float range_high = na
var float range_low = na
var int session_candle_count = 0
var bool range_established = false

// Reset range at session start
if session_start
    range_high := na
    range_low := na
    session_candle_count := 0
    range_established := false

// Count candles in session
if in_trading_session
    session_candle_count += 1

// Establish range from first 4 candles
if in_trading_session and session_candle_count <= range_candles
    if na(range_high) or high > range_high
        range_high := high
    if na(range_low) or low < range_low
        range_low := low
    
    if session_candle_count == range_candles
        range_established := true

// ============================================================================
// FIBONACCI CALCULATIONS
// ============================================================================

var float fib_0 = na
var float fib_50 = na
var float fib_618 = na
var float fib_100 = na
var float breakout_high = na

calculate_fibonacci(range_low_val, breakout_high_val) =>
    fib_0_val = range_low_val
    fib_100_val = breakout_high_val
    fib_50_val = range_low_val + (breakout_high_val - range_low_val) * 0.5
    fib_618_val = range_low_val + (breakout_high_val - range_low_val) * 0.618
    [fib_0_val, fib_50_val, fib_618_val, fib_100_val]

// ============================================================================
// TRADE TRACKING
// ============================================================================

var int trades_today = 0
var bool trade_taken_today = false

// Reset daily trade counter
if dayofweek != dayofweek[1]
    trades_today := 0
    trade_taken_today := false

// ============================================================================
// ENTRY CONDITIONS
// ============================================================================

// Scenario 1: Shadow Break
shadow_break_condition = false
var bool waiting_for_shadow_entry = false
var float shadow_stop_loss = na

if range_established and not trade_taken_today and in_trading_session
    // Check for shadow break (wick above range, body closes inside)
    if high > range_high and close <= range_high and close >= range_low
        waiting_for_shadow_entry := true
        shadow_stop_loss := high
        
// Execute shadow break entry on next candle
if waiting_for_shadow_entry and not trade_taken_today
    shadow_break_condition := true
    waiting_for_shadow_entry := false

// Scenario 2: Body Break and Retracement
body_break_condition = false
var bool waiting_for_retracement = false
var bool body_break_occurred = false

if range_established and not trade_taken_today and in_trading_session
    // Check for body break (close above range)
    if close > range_high and not body_break_occurred
        body_break_occurred := true
        breakout_high := high
        waiting_for_retracement := true
        [fib_0, fib_50, fib_618, fib_100] := calculate_fibonacci(range_low, breakout_high)

// Check for retracement entry
if waiting_for_retracement and not trade_taken_today
    // Price must first close back inside range, then below 50% fib
    if close <= range_high and close < fib_50
        body_break_condition := true
        waiting_for_retracement := false

// ============================================================================
// POSITION SIZING
// ============================================================================

calculate_position_size() =>
    if trades_today == 0
        first_trade_size
    else
        equity_percent = first_trade_size * math.pow(1 + position_increase/100, trades_today)
        math.min(equity_percent, 95.0) // Cap at 95% of equity

// ============================================================================
// TRADE EXECUTION
// ============================================================================

// Entry conditions
enter_shadow_trade = shadow_break_condition and trades_today < max_trades_per_day
enter_body_trade = body_break_condition and trades_today < max_trades_per_day

// Position size calculation
position_size = calculate_position_size()

// Shadow break trade
if enter_shadow_trade
    stop_loss_price = shadow_stop_loss
    entry_price = close
    risk_per_share = stop_loss_price - entry_price
    take_profit_price = entry_price - risk_per_share // 1:1 RR
    
    strategy.entry("Shadow Sell", strategy.short, qty=position_size)
    strategy.exit("Shadow Exit", "Shadow Sell", stop=stop_loss_price, limit=take_profit_price)
    
    trades_today += 1
    trade_taken_today := true
    body_break_occurred := false

// Body break retracement trade
if enter_body_trade
    // Stop loss behind high of previous two candles
    stop_loss_price = math.max(high[1], high[2])
    entry_price = close
    risk_per_share = stop_loss_price - entry_price
    take_profit_price = entry_price - risk_per_share // 1:1 RR
    
    strategy.entry("Body Sell", strategy.short, qty=position_size)
    strategy.exit("Body Exit", "Body Sell", stop=stop_loss_price, limit=take_profit_price)
    
    trades_today += 1
    trade_taken_today := true
    body_break_occurred := false

// ============================================================================
// VISUALIZATION
// ============================================================================

// Plot range lines
plot(show_range and range_established ? range_high : na, color=color.red, linewidth=2, title="Range High")
plot(show_range and range_established ? range_low : na, color=color.green, linewidth=2, title="Range Low")

// Plot Fibonacci levels
plot(show_fibonacci and not na(fib_0) ? fib_0 : na, color=color.blue, linewidth=1, title="Fib 0%")
plot(show_fibonacci and not na(fib_50) ? fib_50 : na, color=color.orange, linewidth=1, title="Fib 50%")
plot(show_fibonacci and not na(fib_618) ? fib_618 : na, color=color.purple, linewidth=1, title="Fib 61.8%")
plot(show_fibonacci and not na(fib_100) ? fib_100 : na, color=color.yellow, linewidth=1, title="Fib 100%")

// Background coloring for trading sessions
bgcolor(in_london_session ? color.new(color.blue, 95) : na, title="London Session")
bgcolor(in_newyork_session ? color.new(color.orange, 95) : na, title="New York Session")

// ============================================================================
// ALERTS & LABELS
// ============================================================================

// Session start labels
if london_session_start
    label.new(bar_index, high, "London Start", style=label.style_label_down, color=color.blue, textcolor=color.white, size=size.small)

if newyork_session_start
    label.new(bar_index, high, "NY Start", style=label.style_label_down, color=color.orange, textcolor=color.white, size=size.small)

// Trade signals
if enter_shadow_trade
    label.new(bar_index, high, "SELL\nShadow", style=label.style_label_down, color=color.red, textcolor=color.white, size=size.normal)

if enter_body_trade
    label.new(bar_index, high, "SELL\nBody", style=label.style_label_down, color=color.maroon, textcolor=color.white, size=size.normal)

// Range establishment
if range_established and session_candle_count == range_candles
    label.new(bar_index, low, "Range Set", style=label.style_label_up, color=color.gray, textcolor=color.white, size=size.small)

// ============================================================================
// TABLE - TRADE STATISTICS
// ============================================================================

var table info_table = table.new(position.top_right, 2, 6, bgcolor=color.white, border_width=1)

if barstate.islast
    table.cell(info_table, 0, 0, "Trades Today:", text_color=color.black, text_size=size.small)
    table.cell(info_table, 1, 0, str.tostring(trades_today), text_color=color.black, text_size=size.small)
    
    table.cell(info_table, 0, 1, "Range High:", text_color=color.black, text_size=size.small)
    table.cell(info_table, 1, 1, not na(range_high) ? str.tostring(range_high, "#.#####") : "N/A", text_color=color.black, text_size=size.small)
    
    table.cell(info_table, 0, 2, "Range Low:", text_color=color.black, text_size=size.small)
    table.cell(info_table, 1, 2, not na(range_low) ? str.tostring(range_low, "#.#####") : "N/A", text_color=color.black, text_size=size.small)
    
    table.cell(info_table, 0, 3, "Next Position:", text_color=color.black, text_size=size.small)
    table.cell(info_table, 1, 3, str.tostring(calculate_position_size(), "#.##") + "%", text_color=color.black, text_size=size.small)
    
    table.cell(info_table, 0, 4, "Session:", text_color=color.black, text_size=size.small)
    session_text = in_london_session ? "London" : in_newyork_session ? "New York" : "None"
    table.cell(info_table, 1, 4, session_text, text_color=color.black, text_size=size.small)
    
    table.cell(info_table, 0, 5, "Range Set:", text_color=color.black, text_size=size.small)
    table.cell(info_table, 1, 5, range_established ? "Yes" : "No", text_color=color.black, text_size=size.small)
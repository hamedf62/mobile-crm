//@version=6
strategy("GBP/USD Range Strategy", overlay=true, initial_capital=100, default_qty_type=strategy.cash, commission_type=strategy.commission.percent, commission_value=0.05)

// Input parameters
initial_trade_size = input.float(40.0, title="Initial Trade Size ($)", minval=1.0)
position_increase = input.float(20.0, title="Position Size Increase (%)", minval=0.0) / 100

// Session definitions (EDT timezone UTC-4)
london_session = input.session("0800-1000", title="London Session (4:00-6:00 AM EDT)")
ny_session = input.session("1300-1500", title="New York Session (9:00-11:00 AM EDT)")

// Variables for range detection
var float range_high = na
var float range_low = na
var int range_candles = 0
var bool range_detected = false
var bool trade_taken_today = false
var bool session_active = false
var int session_candle_count = 0

// Variables for Fibonacci levels
var float fib_high = na
var float fib_low = na
var float fib_0 = na
var float fib_50 = na
var float fib_618 = na
var float fib_100 = na

// Variables for tracking breakout scenarios
var bool shadow_break_setup = false
var bool body_break_setup = false
var bool waiting_for_retracement = false
var float breakout_high = na
var int shadow_candle_index = na
var float shadow_candle_high = na

// Position sizing variables
var int daily_trade_count = 0

// Session detection functions
is_london_session() => 
    session_time = time(timeframe.period, london_session, "America/New_York")
    not na(session_time)

is_ny_session() => 
    session_time = time(timeframe.period, ny_session, "America/New_York")
    not na(session_time)

is_trading_session() => is_london_session() or is_ny_session()

// New day detection
is_new_day() => ta.change(dayofmonth) != 0

// Session start detection
is_session_start() =>
    london_start = is_london_session() and not is_london_session()[1]
    ny_start = is_ny_session() and not is_ny_session()[1]
    london_start or ny_start

// Reset daily variables
if is_new_day()
    trade_taken_today := false

// Reset session variables at start of new session
if is_session_start()
    range_high := na
    range_low := na
    range_candles := 0
    range_detected := false
    shadow_break_setup := false
    body_break_setup := false
    waiting_for_retracement := false
    breakout_high := na
    shadow_candle_index := na
    shadow_candle_high := na
    fib_high := na
    fib_low := na
    fib_0 := na
    fib_50 := na
    fib_618 := na
    fib_100 := na
    session_active := true
    session_candle_count := 0

// Track session candle count
if is_trading_session() and session_active
    session_candle_count += 1

// End session after 2 hours (24 candles on 5min chart)
if session_active and session_candle_count > 24
    session_active := false

// Detect range during first 4 candles of each session
if is_trading_session() and session_active and not range_detected and not trade_taken_today and session_candle_count <= 4
    if session_candle_count == 1
        range_high := high
        range_low := low
        range_candles := 1
    else
        range_high := math.max(range_high, high)
        range_low := math.min(range_low, low)
        range_candles := session_candle_count
    
    if range_candles >= 4
        range_detected := true

// Plot range levels
plot(range_detected and session_active ? range_high : na, color=color.red, linewidth=2, title="Range High")
plot(range_detected and session_active ? range_low : na, color=color.green, linewidth=2, title="Range Low")

// Check for range breaks after range is detected
if range_detected and is_trading_session() and session_active and not trade_taken_today and session_candle_count <= 24
    // Check for ceiling break
    if high > range_high and not shadow_break_setup and not body_break_setup and not waiting_for_retracement
        
        // Scenario 1: Shadow break (body closes inside range)
        if close <= range_high
            shadow_break_setup := true
            shadow_candle_index := bar_index
            shadow_candle_high := high
            
        // Scenario 2: Body break (body closes outside range)
        else if close > range_high
            body_break_setup := true
            waiting_for_retracement := true
            breakout_high := high
            // Set up Fibonacci levels
            fib_low := range_low
            fib_high := breakout_high
            fib_0 := fib_high
            fib_50 := fib_high - (fib_high - fib_low) * 0.5
            fib_618 := fib_high - (fib_high - fib_low) * 0.618
            fib_100 := fib_low

// Plot Fibonacci levels
plot(body_break_setup and session_active and not na(fib_0) ? fib_0 : na, color=color.purple, linewidth=1, title="Fib 0%")
plot(body_break_setup and session_active and not na(fib_50) ? fib_50 : na, color=color.orange, linewidth=1, title="Fib 50%")
plot(body_break_setup and session_active and not na(fib_618) ? fib_618 : na, color=color.yellow, linewidth=1, title="Fib 61.8%")
plot(body_break_setup and session_active and not na(fib_100) ? fib_100 : na, color=color.blue, linewidth=1, title="Fib 100%")

// Calculate position size with compounding
calculate_position_size() =>
    if daily_trade_count == 0
        initial_trade_size
    else
        initial_trade_size * math.pow(1 + position_increase, daily_trade_count)

// Scenario 1: Shadow break entry
if shadow_break_setup and not trade_taken_today and is_trading_session() and session_active and session_candle_count <= 24
    if bar_index > shadow_candle_index
        entry_price = close
        stop_loss_price = shadow_candle_high
        risk = math.abs(stop_loss_price - entry_price)
        take_profit_price = entry_price - risk
        
        // Ensure valid trade setup
        if risk > 0 and take_profit_price < entry_price and stop_loss_price > entry_price
            pos_size = calculate_position_size()
            shares = pos_size / close
            
            if shares > 0
                strategy.entry("Sell_Shadow", strategy.short, qty=shares)
                strategy.exit("Exit_Shadow", "Sell_Shadow", stop=stop_loss_price, limit=take_profit_price)
                
                trade_taken_today := true
                daily_trade_count += 1
                shadow_break_setup := false

// Scenario 2: Body break and retracement entry
if body_break_setup and waiting_for_retracement and not trade_taken_today and is_trading_session() and session_active and session_candle_count <= 24
    // Check if price has retracted back into range and closed below 50% Fib
    if close <= range_high and close < fib_50
        entry_price = close
        stop_loss_price = math.max(high[1], high[2])
        risk = math.abs(stop_loss_price - entry_price)
        take_profit_price = entry_price - risk
        
        // Ensure valid trade setup
        if risk > 0 and take_profit_price < entry_price and stop_loss_price > entry_price
            pos_size = calculate_position_size()
            shares = pos_size / close
            
            if shares > 0
                strategy.entry("Sell_Fib", strategy.short, qty=shares)
                strategy.exit("Exit_Fib", "Sell_Fib", stop=stop_loss_price, limit=take_profit_price)
                
                trade_taken_today := true
                daily_trade_count += 1
                body_break_setup := false
                waiting_for_retracement := false

// Visual indicators
plotshape(shadow_break_setup and bar_index == shadow_candle_index, style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, title="Shadow Break")
plotshape(body_break_setup and waiting_for_retracement, style=shape.triangleup, location=location.belowbar, color=color.orange, size=size.small, title="Body Break")

// Background coloring for trading sessions
bgcolor(is_london_session() ? color.new(color.blue, 95) : na, title="London Session")
bgcolor(is_ny_session() ? color.new(color.purple, 95) : na, title="New York Session")

// Information table
if barstate.islast
    var table info_table = table.new(position.top_right, 2, 9, bgcolor=color.white, border_width=1)
    table.cell(info_table, 0, 0, "Daily Trades", text_color=color.black)
    table.cell(info_table, 1, 0, str.tostring(daily_trade_count), text_color=color.black)
    table.cell(info_table, 0, 1, "Range High", text_color=color.black)
    table.cell(info_table, 1, 1, range_detected ? str.tostring(range_high, "#.#####") : "N/A", text_color=color.black)
    table.cell(info_table, 0, 2, "Range Low", text_color=color.black)
    table.cell(info_table, 1, 2, range_detected ? str.tostring(range_low, "#.#####") : "N/A", text_color=color.black)
    table.cell(info_table, 0, 3, "Range Detected", text_color=color.black)
    table.cell(info_table, 1, 3, range_detected ? "Yes" : "No", text_color=color.black)
    table.cell(info_table, 0, 4, "Trade Taken", text_color=color.black)
    table.cell(info_table, 1, 4, trade_taken_today ? "Yes" : "No", text_color=color.black)
    table.cell(info_table, 0, 5, "Session Active", text_color=color.black)
    table.cell(info_table, 1, 5, session_active ? "Yes" : "No", text_color=color.black)
    table.cell(info_table, 0, 6, "Session Candle", text_color=color.black)
    table.cell(info_table, 1, 6, str.tostring(session_candle_count), text_color=color.black)
    table.cell(info_table, 0, 7, "Position Size", text_color=color.black)
    table.cell(info_table, 1, 7, "$" + str.tostring(calculate_position_size(), "#.##"), text_color=color.black)
    table.cell(info_table, 0, 8, "In Session", text_color=color.black)
    table.cell(info_table, 1, 8, is_trading_session() ? "Yes" : "No", text_color=color.black)